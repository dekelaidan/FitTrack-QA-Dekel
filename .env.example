# Connection for psql and the test suite. Copy to .env, then: source .env
# Default port is 5432. If a local Postgres already uses it, start the DB with
#   FITTRACK_DB_PORT=5433 docker compose up -d --wait
# and set PGPORT=5433 below. Use 127.0.0.1 (not localhost) so nothing drifts to IPv6 ::1.
export PGHOST=127.0.0.1
export PGPORT=5432
export PGDATABASE=fittrack
export PGUSER=fittrack
export PGPASSWORD=fittrack
